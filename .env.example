# ==============================================================================
# COMSATS Portal Tracker Configuration
# Copy this file to .env and fill in your values. Never commit .env to Git.
# ==============================================================================

# Required: ASP.NET_SessionId cookie from https://sis.comsats.edu.pk
# (Browser DevTools -> Application -> Cookies -> https://sis.comsats.edu.pk)
SIS_SESSION_ID=paste_your_ASP_NET_SessionId_here

# Optional: Portal base URL (defaults to Islamabad campus)
SIS_BASE_URL=https://sis.comsats.edu.pk

# Optional: Match your browser's User-Agent (navigator.userAgent in DevTools Console)
SIS_USER_AGENT=

# Polling & Scraping Cadence (seconds)
# KEEPALIVE_INTERVAL pings /Courses lightly to keep the 4-5 min ASP.NET session alive.
# FETCH_INTERVAL runs the full multi-course scan for marks & learning resources.
KEEPALIVE_INTERVAL=120
FETCH_INTERVAL=480
REQUEST_DELAY=0.6

# Optional: Also notify on new course announcements (true/false)
TRACK_ANNOUNCEMENTS=false

# ==============================================================================
# Open-Standard Notifiers (configure one or more; leave blank to disable)
# ==============================================================================

# 1. ntfy (recommended open standard — works with https://ntfy.sh or self-hosted)
# Pick a hard-to-guess topic name, e.g. https://ntfy.sh/cui-sis-a9f3k2m8
NTFY_URL=
# Optional Bearer token if your ntfy topic/server requires authentication
NTFY_TOKEN=

# 2. Generic JSON Webhook (Home Assistant, n8n, Slack, custom HTTP endpoint)
WEBHOOK_URL=

# 3. Discord Webhook
DISCORD_WEBHOOK_URL=

# 4. Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
